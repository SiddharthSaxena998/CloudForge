# ---- Required ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cloudforge
# 16+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- Optional ----
PORT=5000
# Comma separated frontend origins allowed by CORS (default: localhost dev ports)
# CORS_ORIGINS=http://localhost:8080,https://your-dashboard-domain.com
# Set to 1 when running behind Cloudflare Tunnel / Nginx (real client IP for rate limits)
# TRUST_PROXY=1
# Max upload size in MB (default 100)
# MAX_UPLOAD_MB=100
# Rate limits (per IP): login attempts / 15min, API requests / min, deploys+creates / 10min
# AUTH_RATE_LIMIT=20
# API_RATE_LIMIT=300
# DEPLOY_RATE_LIMIT=30
# Free public links for deployed apps (needs `cloudflared` installed). Set false to disable
# ENABLE_TUNNEL=true

# ---- Docker Compose (set automatically by docker-compose.yml; only needed if you run the backend by hand) ----
# TUNNEL_TARGET_HOST=host.docker.internal
# APP_PORT_RANGE=20000-29999
