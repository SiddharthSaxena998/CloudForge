# ---- Required ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cloudforge
# 16+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- Optional ----
PORT=5000
# Comma separated frontend origins allowed by CORS (default: localhost dev ports)
# CORS_ORIGINS=http://localhost:8080,https://your-dashboard-domain.com
# Set to 1 when running behind Cloudflare Tunnel / Nginx (real client IP for rate limits)
# TRUST_PROXY=1
# Max upload size in MB (default 100)
# MAX_UPLOAD_MB=100
# Rate limits (per IP): login attempts / 15min, API requests / min, deploys+creates / 10min
# AUTH_RATE_LIMIT=20
# API_RATE_LIMIT=300
# DEPLOY_RATE_LIMIT=30
# Live metrics push interval in ms (default 3000)
# STATS_INTERVAL_MS=3000
# Free public links for deployed apps (needs `cloudflared` installed). Set false to disable
# ENABLE_TUNNEL=true

# ---- Docker Compose (set automatically by docker-compose.yml; only needed if you run the backend by hand) ----
# TUNNEL_TARGET_HOST=host.docker.internal
# APP_PORT_RANGE=20000-29999

# ---- Phase 2: limits (all optional; admins are exempt from per-user limits) ----
# Per user:   MAX_PROJECTS_PER_USER=5  MAX_RUNNING_CONTAINERS_PER_USER=3
# Abuse:      DEPLOY_COOLDOWN_SEC=20   MAX_DEPLOYS_PER_HOUR=20      (0 = off)
# Per app:    CONTAINER_MEMORY_MB=512  CONTAINER_CPUS=0.5  CONTAINER_PIDS=256
# Builds:     MAX_CONCURRENT_BUILDS=2  BUILD_TIMEOUT_MIN=10  BUILD_MEMORY_MB=2048  BUILD_CPUS=1
# Disk:       MAX_SOURCE_MB=500 (unpacked project)  MIN_FREE_DISK_MB=2048 (refuse new work below this)
# Cleanup:    CLEANUP_INTERVAL_MIN=60 (0 = off)  IMAGE_RETENTION_DAYS=3  ORPHAN_GRACE_HOURS=24
#             CLEANUP_ORPHANS=log   (set to "delete" to remove source folders no project uses)
# Deployed apps are reachable only from this machine/tunnel unless you set CONTAINER_BIND_HOST=0.0.0.0

# ---- Phase 4: who may sign up ----
# If set, the sign-up form asks for this code (share it only with classmates / teachers).
# Leave empty to keep sign-up open to anyone who has the link.
# SIGNUP_CODE=choose-a-secret-phrase
# Admins can block users and change a user's quotas in the dashboard (Admin page).
